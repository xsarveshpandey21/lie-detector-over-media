{
  "name": "lie-detector-over-media",
  "version": "1.0.0",
  "description": "Lie Detector Over Media - check if content is reliable",
  "author": "Sarvesh Pandey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xsarveshpandey21/lie-detector-over-media.git"
  },
  "homepage": "https://github.com/xsarveshpandey21/lie-detector-over-media#readme",
  "private": true,
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start": "node backend/src/server.js",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && node --test test/*.test.js",
    "test:frontend": "cd frontend && npm run test",
    "typecheck": "cd frontend && npm run typecheck",
    "lint": "cd frontend && npm run lint",
    "verify:references": "node scripts/verifyReferences.js",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "dependencies": {
    "axios": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exifr": "^7.1.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "^12.3.2"
  }
}

