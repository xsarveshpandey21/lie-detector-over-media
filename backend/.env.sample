# ==============================================================================
# Lie Detector Over Media - Environment Configuration
# All variables are OPTIONAL. The system runs fully with honest "not checked"
# fallback states if external API keys are not supplied.
# ==============================================================================

# Server Configuration
PORT=8080
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_MB=4
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30

# Fact-Checking Integrations
# Google Fact Check Tools API key (https://toolbox.google.com/factcheck/apis)
FACT_CHECK_GOOGLE_API_KEY=

# LLM Reasoning & Fallback Fact-Checking
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Translation API (https://cloud.google.com/translate)
GOOGLE_TRANSLATE_API_KEY=

# Google Safe Browsing Lookup API (https://developers.google.com/safe-browsing)
GOOGLE_SAFE_BROWSING_KEY=

# Optional Self-Hosted ML Microservices (e.g. from /ml directory)
TEXT_MODEL_URL=
IMAGE_DETECTOR_URL=
VIDEO_DETECTOR_URL=
AUDIO_DETECTOR_URL=
